PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/arswift_hiring
# Any long random string. The frontend and the Google Form script must use the same value.
API_KEY=replace-with-a-long-random-string

# WhatsApp Cloud API (Meta developer dashboard)
# Phone number ID: WhatsApp > API Setup (after the number is registered)
WHATSAPP_PHONE_NUMBER_ID=
# Access token. A temporary one lasts 24 hours; a permanent one comes from a system user later.
WHATSAPP_TOKEN=
# You choose this. Type the same text in the dashboard when you set up the webhook.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret
META_APP_SECRET=
# Optional: shown to people who message us without filling in the form
FORM_URL=

# Email (Hostinger mailbox hr@arswift.com). Leave SMTP_HOST empty to turn automatic emails off.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hr@arswift.com
SMTP_PASS=
# Optional. Default: "AR Swift HR" <SMTP_USER>
MAIL_FROM=
